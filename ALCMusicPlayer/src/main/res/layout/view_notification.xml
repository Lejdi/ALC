<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="horizontal"
    android:id="@+id/notif_layout"
    android:background="@color/controlBackgroundColor">

    <ImageButton
        android:id="@+id/notif_alc_image"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentBottom="true"
        android:background="@color/invisible"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:src="@drawable/alc_logo_foreground" />

    <TextView
        android:id="@+id/notif_filename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/notif_button_prev"
        android:layout_toEndOf="@+id/notif_alc_image"
        android:padding="9dp"
        android:singleLine="true"
        android:text="@string/alc_stopped"
        android:textColor="@color/iconsColor"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/notif_button_prev"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentBottom="true"
        android:layout_marginVertical="6dp"
        android:layout_toStartOf="@id/notif_button_pauseresume"
        android:background="@color/invisible"
        android:padding="8dp"
        android:foregroundTint="@color/iconsColor"
        android:src="@drawable/vector_notif_prevsong" />

    <ImageButton
        android:id="@+id/notif_button_pauseresume"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:layout_marginVertical="6dp"
        android:layout_alignParentBottom="true"
        android:background="@color/invisible"
        android:src="@drawable/ic_baseline_play_circle_outline_24"
        android:layout_toStartOf="@+id/notif_button_next"
        app:tint="@color/iconsColor" />

    <ImageButton
        android:id="@+id/notif_button_next"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:padding="8dp"
        android:layout_marginVertical="6dp"
        android:layout_alignParentBottom="true"
        android:src="@drawable/vector_notif_nextsong"
        android:background="@color/invisible"
        android:layout_toStartOf="@+id/notif_button_stop_alc"/>

    <ImageButton
        android:id="@+id/notif_button_stop_alc"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:padding="4dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_baseline_close_24"
        android:background="@color/invisible" />
</RelativeLayout>