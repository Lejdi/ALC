<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="100dp"
    android:orientation="horizontal"
    android:id="@+id/notif_layout"
    android:background="@color/controlBackgroundColor">

    <ImageButton
        android:id="@+id/notif_alc_image"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/alc_logo_foreground"
        app:tint="@color/iconsColor"
        android:background="@color/invisible"/>

    <TextView
        android:id="@+id/notif_filename"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/notif_button_stop_alc"
        android:layout_toEndOf="@+id/notif_alc_image"
        android:padding="9dp"
        android:singleLine="true"
        android:text="@string/alc_stopped"
        android:textColor="@color/iconsColor"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/notif_artist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/notif_filename"
        android:layout_marginStart="10dp"
        android:layout_toStartOf="@id/notif_button_prev"
        android:layout_toEndOf="@+id/notif_alc_image"
        android:padding="3dp"
        android:singleLine="true"
        android:text="-"
        android:textColor="@color/iconsColor"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/notif_songtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="3dp"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@+id/notif_alc_image"
        android:layout_toStartOf="@id/notif_button_prev"
        android:layout_below="@+id/notif_artist"
        android:singleLine="true"
        android:textSize="13sp"
        android:textColor="@color/iconsColor"
        android:text="-" />

    <ImageButton
        android:id="@+id/notif_button_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_marginVertical="12dp"
        android:layout_toStartOf="@id/notif_button_pauseresume"
        android:background="@color/invisible"
        android:padding="8dp"
        android:src="@drawable/vector_notif_prevsong"
        app:tint="@color/iconsColor" />

    <ImageButton
        android:id="@+id/notif_button_pauseresume"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:layout_marginVertical="12dp"
        android:layout_alignParentBottom="true"
        android:background="@color/invisible"
        android:src="@drawable/ic_baseline_play_circle_outline_24"
        app:tint="@color/iconsColor"
        android:layout_toStartOf="@+id/notif_button_next"/>

    <ImageButton
        android:id="@+id/notif_button_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:padding="8dp"
        android:layout_marginVertical="12dp"
        android:layout_marginEnd="16dp"
        android:layout_alignParentBottom="true"
        android:src="@drawable/vector_notif_nextsong"
        app:tint="@color/iconsColor"
        android:background="@color/invisible"
        android:layout_alignParentEnd="true"/>

    <ImageButton
        android:id="@+id/notif_button_stop_alc"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="4dp"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="4dp"
        android:src="@drawable/ic_baseline_close_24"
        app:tint="@color/iconsColor"
        android:background="@color/invisible"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="10dp" />
</RelativeLayout>